# Copy to .env and fill in. Real environment variables take precedence over this file.

# --- Server ---------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
# "production" turns on Secure cookies + HSTS and disables the developer sign-in.
NODE_ENV=development
# true when running behind a proxy / load balancer (Render, Fly, Nginx…)
TRUST_PROXY=false

# --- Google sign-in (needed only to save schools) --------------------------
# Create an OAuth 2.0 "Web application" client at https://console.cloud.google.com/apis/credentials
# and add your site's origin (e.g. http://localhost:3000) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Long random string that signs session cookies (required in production):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional allow-lists. Leave both blank to allow any verified Google account.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# Sign out after this many hours of inactivity (sessions also end after SESSION_MAX_DAYS)
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# --- Local development only -------------------------------------------------
# Adds "Continue as local developer" to the sign-in dialog. Ignored when NODE_ENV=production.
DEV_LOGIN=false

# --- Storage --------------------------------------------------------------
# SQLite database file (saved schools, tracker, events). Mount a disk here in production.
# DB_PATH=./data/app.db
# SEED_PATH=./data/seed/schools.json

# --- Address search ---------------------------------------------------------
# Set to true to skip NYC Planning GeoSearch (zip codes still work offline).
OFFLINE=false
